# Copy to staging/frontend.env.local. This file contains browser-public values.
# Create a separate Supabase project for staging; never reuse the local/dev one.
CORAL_STAGING=true
STAGING_FRONTEND_ORIGIN=http://127.0.0.1:4173
VITE_API_URL=http://127.0.0.1:3002/api/v1
VITE_SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-staging-publishable-or-anon-key
# Optional Google chooser. Register the staging origin with this OAuth client.
VITE_GOOGLE_CLIENT_ID=
# List only social providers enabled in this Supabase project. Blank uses email only.
VITE_SOCIAL_AUTH_PROVIDERS=

# Never put service-role, database, payment-secret or other private keys here.
