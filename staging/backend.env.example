# Copy to staging/backend.env.local. Keep this server-only file private.
# These connection/key placeholders must all belong to one NEW staging project.
CORAL_STAGING=true
STAGING_SUPABASE_PROJECT_REF=replace-with-staging-project-ref
NODE_ENV=production
HOST=127.0.0.1
PORT=3002
API_PREFIX=api/v1
STAGING_API_ORIGIN=http://127.0.0.1:3002
FRONTEND_URL=http://127.0.0.1:4173
CORS_ORIGINS=http://127.0.0.1:4173
OAUTH_REDIRECT_URL=http://127.0.0.1:4173

SUPABASE_URL=https://replace-with-staging-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-secret-or-service-role-key
SUPABASE_JWT_SECRET=
# Replace REGION, project ref and URL-encoded password with staging values.
DATABASE_URL=postgresql://postgres.replace-with-staging-project-ref:replace-with-url-encoded-staging-password@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.replace-with-staging-project-ref:replace-with-url-encoded-staging-password@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Start disabled. These flags apply to the whole environment, not a cohort.
MARKETPLACE_LISTING_WRITES_ENABLED=false
MARKETPLACE_ENQUIRIES_ENABLED=false
SCHEDULED_JOBS_ENABLED=true
# Blank avoids auto-promoting a placeholder/default administrator.
DEFAULT_ADMIN_EMAIL=

# External deliveries, payments and integrations stay unconfigured initially.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
OPENAI_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
STRIPE_AUTOMATIC_TAX=false
BILLING_DEFAULT_CURRENCY=cad
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
