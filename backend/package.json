{
  "name": "backend",
  "version": "1.0.0",
  "description": "Job Platform Backend API",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:typecheck": "tsc --noEmit -p test/tsconfig.json",
    "seed": "ts-node scripts/seed.ts",
    "seed:messaging": "ts-node scripts/seed-messaging.ts",
    "make:admin": "ts-node scripts/make-admin.ts",
    "audit:stability": "ts-node scripts/audit-score-stability.ts",
    "verify:analytics": "ts-node scripts/verify-analytics-capture.ts",
    "verify:analytics:wiring": "ts-node scripts/verify-analytics-wiring.ts",
    "verify:recommendations": "ts-node --transpile-only scripts/verify-recommendation-rules.ts",
    "verify:recommendations:e2e": "ts-node --transpile-only scripts/verify-recommendations-e2e.ts",
    "verify:scheduled-jobs": "ts-node --transpile-only scripts/verify-scheduled-jobs.ts",
    "verify:seat-permissions": "ts-node --transpile-only scripts/verify-seat-permissions.ts",
    "verify:candidate-tags": "ts-node --transpile-only scripts/verify-candidate-tags.ts",
    "verify:outreach-templates": "ts-node --transpile-only scripts/verify-outreach-templates.ts",
    "verify:outreach-timing": "ts-node --transpile-only scripts/verify-outreach-timing.ts",
    "verify:offer-signals": "ts-node --transpile-only scripts/verify-offer-signals.ts",
    "types:generate": "ts-node scripts/generate-types.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.14",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.14",
    "@nestjs/platform-express": "^11.1.14",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/adapter-pg": "7.4.1",
    "@prisma/client": "7.4.1",
    "@supabase/supabase-js": "^2.97.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@stripe/cli": "^1.52.0",
    "@types/compression": "^1.8.1",
    "@types/cron": "^2.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "7.4.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
