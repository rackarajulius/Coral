# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (Supabase PostgreSQL) — Supabase dashboard → Connect
# App runtime: the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Prisma CLI (migrate/status/studio): the session pooler (port 5432). Migrations hang on 6543.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Where the app runs in the browser (dev: 8081, see vite.config.ts).
# Every link the backend builds starts with this: Stripe returns, emails,
# team invitations, interview rooms, OAuth callbacks.
FRONTEND_URL=http://localhost:8081

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Server-only: required for storage and account deletion. Never use a VITE_ name.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI (Interview Prep)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=25000

# Email (Resend)
RESEND_URL=https://api.resend.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Loavable <no-reply@yourdomain.com>
EMAIL_REPLY_TO=support@yourdomain.com
RESEND_TIMEOUT_MS=20000

# Payments (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_API_URL=https://api.stripe.com/v1
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# --- Company subscriptions (employer billing) ---
# Stripe price ids for each purchasable plan and interval. Without these the
# upgrade routes report that billing is not configured rather than failing.
# Starter is free and Enterprise is negotiated, so neither has a price here.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Optional: only if Enterprise ever becomes self-serve.
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
# Pinned so a Stripe field-shape change cannot silently alter what webhooks read.
STRIPE_API_VERSION=2024-06-20
# Ask Stripe to calculate tax at checkout. OFF unless set to exactly "true":
# enabling it without an origin address registered in Stripe Tax does not
# degrade, it makes Stripe refuse every checkout session with "You must have a
# valid head office address". Configure the head office first, at
# https://dashboard.stripe.com/test/settings/tax, then turn this on.
STRIPE_AUTOMATIC_TAX=false
# Stripe fixes a customer's currency at their first payment and it can never be
# changed afterwards. Canada-first.
BILLING_DEFAULT_CURRENCY=cad

# OAuth Redirect URLs
OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Default admin email used to auto-assign ADMIN role on first sign-in
# Set to the email address of your administrator. Leave blank to disable.
DEFAULT_ADMIN_EMAIL=admin@example.com

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optional, for caching/sessions)
REDIS_URL=redis://localhost:6379

# Job Alerts (optional tuning)
JOB_ALERTS_DISPATCH_LIMIT=100
JOB_ALERTS_MATCH_LIMIT=10
JOB_ALERTS_INSTANT_INTERVAL_MIN=15
JOB_ALERTS_DEFAULT_LOOKBACK_HOURS=24
# Job-seeker Premium. Unset: every Premium feature is open to everyone.
# "true" gates them all. Or list the ones switched on so far, comma-separated:
# matcher.web, assist.cover_letter, assist.tailor, research.company, coach.session
# (limits per plan are in src/seeker-entitlements/seeker-entitlements.ts).
PREMIUM_ENFORCEMENT=matcher.web
# Alerts also search the web, once a day per alert (weekly alerts weekly), on
# a 30-minute schedule. Alerts checked per pass (0 switches web alerts off):
JOB_ALERTS_WEB_CHECKS_PER_PASS=5
# Web checks a day, across everyone, that may use JSearch (1–3 requests each).
# Its free plan has 200 requests a month for every search, so keep this low.
JOB_ALERTS_WEB_JSEARCH_PER_DAY=2
# Phase 2 creation/edit/publication gate; only exact true enables writes.
# Reads, owner history, pausing, closing, archiving and reports remain available.
MARKETPLACE_LISTING_WRITES_ENABLED=false
# Phase 3 contact gate: only literal true enables introductions, accepts and
# messages. Reading history and decline/withdraw/block/report stay available.
MARKETPLACE_ENQUIRIES_ENABLED=false

# --- Resume matcher job sources (/resume-matcher) ---
# Each source is off until configured. Coral's own jobs are always searched.
# Adzuna: free key from https://developer.adzuna.com. Needs both values.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ca
# JSearch via RapidAPI (Google for Jobs: Indeed, LinkedIn, Job Bank, employer
# sites). The RapidAPI app key (contains "msh"; RapidAPI → My Apps → app →
# Authorizations), and the account must be subscribed to JSearch. The free
# Basic plan is 200 requests/month, hard limit; results are cached an hour per
# role and city. A key from OpenWeb Ninja's own portal ("ak_…") won't work here.
RAPID_API_KEY=
JSEARCH_COUNTRY=ca
# Employer job boards: public APIs, no key. "board:Company Name:website",
# comma-separated, at most 8 per platform. Name and website are optional, but
# the board handle is often not the company's name, and the website is what
# gives the match card a logo (copied once into our storage); without it the
# card shows a letter. Every board below was checked live on 2026-10-15 and
# has open roles in Canada. A board that answers 404 has usually moved platform
# (Wealthsimple and Jobber both moved from Greenhouse/Lever to Ashby).
GREENHOUSE_BOARDS=clutch:Clutch:clutch.ca,geotab:Geotab:geotab.com,flipp:Flipp:flipp.com,shakepay:Shakepay:shakepay.com,d2l:D2L:d2l.com,hootsuite:Hootsuite:hootsuite.com
LEVER_COMPANIES=magnetforensics:Magnet Forensics:magnetforensics.com,getmaple:Maple:getmaple.ca,achievers:Achievers:achievers.com,waveapps:Wave:waveapps.com,wattpad:Wattpad:wattpad.com
ASHBY_BOARDS=lightspeedhq:Lightspeed:lightspeedhq.com,cohere:Cohere:cohere.com,neofinancial:Neo Financial:neofinancial.com,wealthsimple:Wealthsimple:wealthsimple.com,1password:1Password:1password.com,jobber:Jobber:getjobber.com,jane:Jane:jane.app,float:Float:floatfinancial.com
# Logo.dev SECRET key (sk_..., from https://www.logo.dev/dashboard). Server-side
# only: never put it in the frontend .env. Gives match cards real logos, finds
# Adzuna employers' websites by name, and replaces site icons where it has a
# better logo. Logos are copied into our storage once per company (2 API
# credits each). The free plan requires the "Logos provided by Logo.dev" link,
# which is in the site footer. Without it, board employers get site icons and
# Adzuna cards keep their letter.
LOGO_DEV_SECRET_KEY=
# Company research on match cards (Firecrawl search + scrape).
FIRECRAWL_API_KEY=
